rules_version = '2';

// The app stores its decks, ink and settings in Firestore, not in Storage —
// nothing in src/ uploads a file today. These rules therefore say the smallest
// true thing: if a per-user upload is ever added, it lives under the owner's
// own folder and nobody else can see it. Everything else is denied.
//
// (The starter rule this replaces was a time-boxed "anyone may read and write
// the whole bucket", which has since expired.)
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
