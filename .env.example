# Firebase web config (client) — copy to .env and fill with your project's values.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Optional — enables Firebase Analytics when present.
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# There is no admin UID any more: every signed-in account owns its own private
# classes, decks, batches and settings under users/{uid} (see firestore.rules).
